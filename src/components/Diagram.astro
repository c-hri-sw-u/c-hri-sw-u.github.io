---
// A simple diagram written as data in a scene, for facts buried in a dense board (the short pages, docs/detail-pages.md §12).
// pairs: one thing turns into another, row by row (t, d → to, toNote). steps: a sequence or a timeline (t, d).
// cycle: a loop, read clockwise from the top (t, d), with an optional word in the middle; on a phone, a column whose
// bracket on the left carries the last item back to the first.
// Same hand as the line drawings: hairlines in --fg, words in the page's serif, arriving one after another.
interface Item { t: string; d?: string; to?: string; toNote?: string }
interface Props { kind: 'pairs' | 'steps' | 'cycle'; items: Item[]; heads?: string[]; center?: string }
const { kind, items, heads, center } = Astro.props;
const n = items.length;

// cycle: nodes on a circle of radius R (in a 100-unit box), an arc with an arrowhead between each pair.
const R = 37, GAP = n > 5 ? 19 : 23; // degrees left clear around each node
const at = (deg: number) => [50 + R * Math.cos((deg * Math.PI) / 180), 50 + R * Math.sin((deg * Math.PI) / 180)];
const angle = (i: number) => -90 + (360 / n) * i;
const arcs = Array.from({ length: n }, (_, i) => {
  const a0 = angle(i) + GAP, a1 = angle(i + 1) - GAP, r1 = (a1 * Math.PI) / 180;
  const [x0, y0] = at(a0), [x1, y1] = at(a1);
  // Arrowhead at the end: two short strokes back along the tangent (clockwise), splayed across the radius.
  const tx = -Math.sin(r1), ty = Math.cos(r1), rx = Math.cos(r1), ry = Math.sin(r1);
  const f = (v: number) => v.toFixed(2);
  const head = `M${f(x1 - 2.2 * tx + 1.5 * rx)} ${f(y1 - 2.2 * ty + 1.5 * ry)} L${f(x1)} ${f(y1)} L${f(x1 - 2.2 * tx - 1.5 * rx)} ${f(y1 - 2.2 * ty - 1.5 * ry)}`;
  return `M${f(x0)} ${f(y0)} A${R} ${R} 0 0 1 ${f(x1)} ${f(y1)} ${head}`;
});
---
{kind === 'pairs' && (
  <div class="dg dg-pairs">
    {heads && <p class="dg-row dg-heads"><span>{heads[0]}</span><span></span><span>{heads[1]}</span></p>}
    {items.map((it, k) => (
      <p class="dg-row" style={`--k:${k}`}>
        <span class="dg-a">{it.t}{it.d && <small>{it.d}</small>}</span>
        <span class="dg-arrow" aria-hidden="true"></span>
        <span class="dg-b">{it.to}{it.toNote && <small>{it.toNote}</small>}</span>
      </p>
    ))}
  </div>
)}
{kind === 'steps' && (
  <ol class="dg dg-steps" style={`--n:${n}`}>
    {items.map((it, k) => <li style={`--k:${k}`}><b>{it.t}</b>{it.d && <small>{it.d}</small>}</li>)}
  </ol>
)}
{kind === 'cycle' && (
  <div class="dg dg-cycle">
    <svg viewBox="0 0 100 100" aria-hidden="true">
      {arcs.map((d, k) => <path pathLength="1" d={d} style={`--k:${k}`} />)}
    </svg>
    {center && <p class="dg-center">{center}</p>}
    <ol>
      {items.map((it, k) => {
        const [x, y] = at(angle(k));
        return <li style={`left:${x.toFixed(2)}%;top:${y.toFixed(2)}%;--k:${k}`}><b>{it.t}</b>{it.d && <small>{it.d}</small>}</li>;
      })}
    </ol>
  </div>
)}

<style is:global>
  .dg { margin: 0; padding: 0; list-style: none; color: var(--fg) }
  .dg b { font-weight: 300 }
  .dg small { display: block; margin-top: 3px; font-family: var(--font-name); font-size: 12.5px; line-height: 1.4; color: var(--dim) }

  /* pairs: left and right columns meet at an arrow, a hairline between rows */
  .dg-pairs { width: min(100%, 760px); display: grid }
  .dg-row { margin: 0; display: grid; grid-template-columns: minmax(0, 1fr) clamp(36px, 7vw, 72px) minmax(0, 1fr); align-items: center; gap: 0 clamp(10px, 2vw, 20px); padding: 9px 0; border-top: 1px solid var(--line); font-size: clamp(16px, 1.9vw, 21px); line-height: 1.2 }
  .dg-row:last-child { border-bottom: 1px solid var(--line) }
  .dg-a { text-align: right } .dg-b { text-align: left }
  .dg-heads { border-top: 0; padding-bottom: 6px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .02em; color: var(--dim) }
  .dg-arrow { position: relative; height: 1px; background: var(--fg); opacity: .55 }
  .dg-arrow::after { content: ""; position: absolute; right: 0; top: -3.5px; width: 7px; height: 7px; border-top: 1px solid var(--fg); border-right: 1px solid var(--fg); transform: rotate(45deg); transform-origin: center }

  /* steps: dots on one line, left to right; a column on a phone */
  .dg-steps { width: min(100%, 1080px); display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); text-align: center }
  .dg-steps li { position: relative; padding: 26px 8px 0; font-size: clamp(15px, 1.5vw, 18px); line-height: 1.2 }
  .dg-steps li::before { content: ""; position: absolute; top: 6px; left: 0; right: 0; height: 1px; background: var(--fg); opacity: .45 }
  .dg-steps li:first-child::before { left: 50% } .dg-steps li:last-child::before { right: 50% }
  .dg-steps li::after { content: ""; position: absolute; top: 2px; left: calc(50% - 4.5px); width: 9px; height: 9px; border-radius: 50%; background: var(--bg); border: 1px solid var(--fg) }
  @media (max-width: 640px) {
    .dg-steps { grid-template-columns: 1fr; width: min(100%, 360px); text-align: left; row-gap: 12px }
    .dg-steps li { padding: 0 0 0 30px; font-size: 16px }
    .dg-steps li::before { top: 0; bottom: -12px; left: 10px; right: auto; width: 1px; height: auto }
    .dg-steps li:first-child::before { left: 10px; top: 8px } .dg-steps li:last-child::before { right: auto; bottom: auto; height: 8px }
    .dg-steps li::after { top: 4px; left: 6px }
  }

  /* cycle: a ring of arrows, the nodes sitting on it */
  .dg-cycle { position: relative; width: min(100%, 460px, 52svh); aspect-ratio: 1 }
  .dg-cycle svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible }
  .dg-cycle path { fill: none; stroke: var(--fg); stroke-opacity: .55; stroke-width: .35; stroke-linecap: round; stroke-linejoin: round }
  .dg-cycle ol { margin: 0; padding: 0; list-style: none }
  .dg-cycle li { position: absolute; transform: translate(-50%, -50%); width: max-content; max-width: 34%; text-align: center; font-size: clamp(14px, 1.6vw, 17px); line-height: 1.2 }
  .dg-cycle small { font-size: 11.5px }
  .dg-center { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; font-family: var(--font-mono); font-size: 11px; letter-spacing: .02em; color: var(--dim) }

  /* arriving: rows, steps and nodes one after another; the ring draws itself */
  html.js .dg-row, html.js .dg-steps li, html.js .dg-cycle li { opacity: 0; transform: translateY(6px); transition: opacity .7s ease, transform .7s var(--ease) }
  html.js .dg-cycle li { transform: translate(-50%, calc(-50% + 6px)) }
  html.js .dg-cycle path { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset .6s var(--ease) }
  html.js .scene.on .dg-row, html.js .scene.on .dg-steps li { opacity: 1; transform: none; transition-delay: calc(.3s + var(--k, 0) * .14s) }
  html.js .scene.on .dg-heads { transition-delay: .2s }
  html.js .scene.on .dg-cycle li { opacity: 1; transform: translate(-50%, -50%); transition-delay: calc(.3s + var(--k) * .45s) }
  html.js .scene.on .dg-cycle path { stroke-dashoffset: 0; transition-delay: calc(.55s + var(--k) * .45s) }
  /* on a phone the cycle becomes a column (after the rules above, so it wins) */
  @media (max-width: 560px) {
    .dg-cycle { width: min(100%, 360px); aspect-ratio: auto }
    .dg-cycle svg, .dg-center { display: none }
    .dg-cycle ol { position: relative; display: grid; row-gap: 12px; padding-left: 16px }
    .dg-cycle ol::before { content: ""; position: absolute; left: 0; top: 7px; bottom: 7px; width: 14px; border: 1px solid var(--fg); border-right: 0; border-radius: 10px 0 0 10px; opacity: .45 }
    .dg-cycle ol::after { content: ""; position: absolute; left: 7px; top: 3.5px; width: 7px; height: 7px; border-top: 1px solid var(--fg); border-right: 1px solid var(--fg); transform: rotate(45deg); opacity: .6 }
    .dg-cycle li { position: relative; left: auto !important; top: auto !important; transform: none; width: auto; max-width: none; padding-left: 16px; text-align: left; font-size: 16px }
    .dg-cycle li::before { content: ""; position: absolute; left: -2px; top: 4px; width: 7px; height: 7px; border-radius: 50%; background: var(--bg); border: 1px solid var(--fg) }
    .dg-cycle li:not(:last-child)::after { content: ""; position: absolute; left: 2px; top: 11px; bottom: -16px; width: 1px; background: var(--fg); opacity: .45 }
    .dg-cycle small { font-size: 12px }
    html.js .dg-cycle li { transform: translateY(6px) }
    html.js .scene.on .dg-cycle li { transform: none; transition-delay: calc(.3s + var(--k) * .14s) }
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .dg-row, html.js .dg-steps li { opacity: 1; transform: none; transition: none }
    html.js .dg-cycle li { opacity: 1; transform: translate(-50%, -50%); transition: none }
    @media (max-width: 560px) { html.js .dg-cycle li { transform: none } }
    html.js .dg-cycle path { stroke-dashoffset: 0; transition: none }
  }
</style>
