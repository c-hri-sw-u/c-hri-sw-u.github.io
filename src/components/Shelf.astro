---
// Three companion robots on a shelf, above "stayed where we put them": the shelf draws first,
// then the robots one by one, in the same hairline as the page's rules.
const eye = (x: number, y: number) => `M${x} ${y - 3} A3 3 0 1 1 ${x - 0.1} ${y - 3} Z`;
---
<svg class="drawing r" viewBox="0 0 600 210" aria-hidden="true">
  <path pathLength="1" d="M80 170 H520 M120 170 V192 L142 170 M480 170 V192 L458 170" />
  <g class="obj">
    <path pathLength="1" d={`M130 170 Q130 108 170 108 Q210 108 210 170 ${eye(158, 142)} ${eye(182, 142)}`} />
  </g>
  <g class="obj">
    <path pathLength="1" d={`M266 170 Q262 100 300 100 Q338 100 334 170 M274 110 L281 86 L293 103 M307 103 L319 86 L326 110 ${eye(288, 134)} ${eye(312, 134)}`} />
  </g>
  <g class="obj">
    <path pathLength="1" d={`M390 170 Q392 126 430 126 Q468 126 470 170 M430 126 V110 M430 102 A4 4 0 1 1 429.9 102 Z ${eye(418, 150)} ${eye(442, 150)}`} />
  </g>
</svg>
