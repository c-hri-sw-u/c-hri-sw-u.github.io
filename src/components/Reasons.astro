    <text x="96" y="214">Fashion</text><text x="96" y="232">item</text>
    <text x="244" y="214">AI</text><text x="244" y="232">companion</text>
  </g>
  <g class="st2">
    <path pathLength="1" d="M300 160 C 350 160, 350 104, 410 104 M402 99 L410 104 L402 109" />
    <path pathLength="1" d="M300 180 C 350 180, 350 216, 410 216 M402 211 L410 216 L402 221" />
    <text class="term" x="424" y="114">Closer to your body</text>
    <text class="aside" x="426" y="140">more emotional connection</text>
    <text class="term" x="424" y="226">With you all day</text>
    <text class="aside" x="426" y="252">no social awkwardness</text>
