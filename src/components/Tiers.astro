---
// Witness's memory, from frames to one page: the three tiers it writes into OpenClaw's markdown memory, each narrower than
// the one above: what each holds, and when the agent reads it (the when, in pink). Frames pour in at the top as a row of small squares.
const W = 400;
const tiers = [
  { file: 'physical-logs/', what: 'a note per scene', when: 'searched when needed', w: 340 },
  { file: 'physical-insights/', what: 'today and yesterday', when: 'read as a chat begins', w: 270 },
  { file: 'physical-pattern.md', what: 'who it thinks I am', when: 'read before every reply', w: 200 },
];
const top = 52, rowH = 92, boxH = 38;
const rr = (x: number, y: number, w: number, h: number, r: number) =>
  `M${x + r} ${y} H${x + w - r} A${r} ${r} 0 0 1 ${x + w} ${y + r} V${y + h - r} A${r} ${r} 0 0 1 ${x + w - r} ${y + h} ` +
  `H${x + r} A${r} ${r} 0 0 1 ${x} ${y + h - r} V${y + r} A${r} ${r} 0 0 1 ${x + r} ${y} Z`;
const frames = Array.from({ length: 23 }, (_, i) => 26 + i * 15.5);
---
<svg class="drawing tiers r" viewBox={`0 0 ${W} ${top + rowH * 3 - 10}`} aria-hidden="true">
  <g class="obj frames">
    {frames.map(fx => <path pathLength="1" d={rr(fx, 8, 10, 8, 1.5)} />)}
    <path pathLength="1" d={`M${W / 2} 24 v${top - 30} m-4 -5 l4 5 l4 -5`} />
  </g>
  {tiers.map((t, i) => {
    const y = top + i * rowH, x = (W - t.w) / 2;
    return (
      <g class="obj tier">
        <path pathLength="1" d={rr(x, y, t.w, boxH, 6)} />
        {i < 2 && <path pathLength="1" d={`M${W / 2} ${y + boxH + 4} v${rowH - boxH - 8} m-4 -5 l4 5 l4 -5`} />}
        <text class="file" x={W / 2} y={y + 24}>{t.file}</text>
        <text class="what" x={W / 2 - 10} y={y + boxH + 20}>{t.what}</text>
        <text class="when" x={W / 2 + 10} y={y + boxH + 20}>{t.when}</text>
      </g>
    );
  })}
</svg>

<style is:global>
  .drawing.tiers { width: min(100%, 560px, calc(50svh * 400 / 318)) }
  .tiers path { vector-effect: none; stroke-width: .9 }
  .tiers .frames path { stroke-opacity: .4 }
  .tiers text { font-size: 12px }
  .tiers text.what { text-anchor: end } .tiers text.when { text-anchor: start }
  .tiers text.file { font-family: var(--font-mono); font-size: 12.5px; fill: var(--fg) }
  .tiers text.when { fill: var(--signal) }
  html.js .scene.on .drawing.tiers .obj:nth-of-type(1) path { transition-delay: .4s }
  html.js .scene.on .drawing.tiers .obj:nth-of-type(2) path { transition-delay: 1s } html.js .scene.on .drawing.tiers .obj:nth-of-type(2) text { transition-delay: 1.5s }
  html.js .scene.on .drawing.tiers .obj:nth-of-type(3) path { transition-delay: 1.7s } html.js .scene.on .drawing.tiers .obj:nth-of-type(3) text { transition-delay: 2.2s }
  html.js .scene.on .drawing.tiers .obj:nth-of-type(4) path { transition-delay: 2.4s } html.js .scene.on .drawing.tiers .obj:nth-of-type(4) text { transition-delay: 2.9s }
</style>
