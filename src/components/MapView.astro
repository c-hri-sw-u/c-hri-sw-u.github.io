---
// The map of every work: hairline axes, coded glyphs and their path, drawn in the homepage's quiet
// style. A few inhabitants from the legacy map (public/map.html) stay: two forests, a kiwi, a UFO, the notebook (Medium), the compass; plus the Parthenon's plan where the path begins.
import type { CollectionEntry } from 'astro:content';
import { glyph } from '../lib/glyph';
import { links } from '../data/home';

interface Props {
  works: CollectionEntry<'works'>[];
  onHome: Set<string>;
  codeOf: (w: CollectionEntry<'works'>) => string;
  hrefOf: (id: string) => string | undefined;
}
const { works, onHome, codeOf, hrefOf } = Astro.props;
const byId = Object.fromEntries(works.map(w => [w.id, w]));
const latestId = works[works.length - 1].id;

let linePaths = '';
for (let i = 0; i < works.length - 1; i++) {
  const a = works[i].data, b = works[i + 1].data;
  const dash = a.stage !== b.stage ? ' class="dash"' : '';
  linePaths += `<path${dash} d="M${a.icon.position[0]} ${a.icon.position[1]}L${b.icon.position[0]} ${b.icon.position[1]}"/>`;
}
// The 2024 Lino prototype and the 2026 product are one story: a faint wide line ties them.
if (byId['lino'] && byId['lino-app']) {
  const a = byId['lino'].data.icon.position, b = byId['lino-app'].data.icon.position;
  linePaths += `<path class="tie" d="M${a[0]} ${a[1]}L${b[0]} ${b[1]}"/>`;
}
// Forests, as the rows of trees in public/tree-flip.js.
const forests = [
  { rows: [2, 3, 2, 6, 5, 4, 5], x: 18.5, y: 40, tree: 'Coniferous' },
  { rows: [2, 3, 2, 5, 3], x: 27, y: 31, tree: 'Deciduous' },
];
const kiwiLines = [
  "I'm a kiwi bird. Ask me anything.",
  "Well... actually, you can't ask.",
  'This is a personal website, played like a puzzle.',
  'Click whatever catches your eye.',
  "I'm here because I'm super bored.",
];
---
<section id="map" aria-label={`Map of all ${works.length} works`}>
  <div class="plane" id="plane">
    <div class="axes" aria-hidden="true">
      <i class="ax-h"></i><i class="ax-v"></i>
      <span class="ax-l">&lt;&nbsp; Reality</span><span class="ax-r">Vision &nbsp;&gt;</span>
      <span class="ax-t"><b>&lt;</b>Digital</span><span class="ax-b">Physical<b>&lt;</b></span>
    </div>

    <div class="deco" aria-hidden="true">
      {forests.map((f, n) => (
        <div class="forest" data-forest={n} style={`left:${f.x}%;top:${f.y}%`}>
          {f.rows.map(r => <div class="trow">{r === 0 ? <span class="gap"></span> : Array.from({ length: r }, () => <img src={`/icon/${f.tree} Tree.svg`} alt="" />)}</div>)}
        </div>
      ))}
      <!-- The Parthenon's plan, under the start of the path: where I came from (trained as an architect). -->
      <img class="parthenon" src="/icon/Parthenon Top View.svg" alt="" title="Where I came from" />
    </div>

    <svg class="links" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" set:html={linePaths}></svg>

    {works.map(w => (
      <button class:list={['mapicon', { feat: onHome.has(w.id) }]} data-id={w.id} data-title={w.data.listTitle}
        data-date={w.data.date} data-preview={w.data.preview} data-url={hrefOf(w.id)}
        style={`left:${w.data.icon.position[0]}%;top:${w.data.icon.position[1]}%`} aria-label={`${codeOf(w)} ${w.data.listTitle}`}>
        <Fragment set:html={glyph(w.data.icon, codeOf(w))} />
        {w.id === latestId && <span class="bubble now">I’m into this now</span>}
      </button>
    ))}

    <div class="kiwi" id="kiwi" style="left:10%;top:16%" title="A kiwi">
      <span class="kiwi-body"><img class="k0" src="/icon/kiwi-bird-svgrepo-com.svg" alt="" /><img class="kb" src="/icon/Kiwi.svg" alt="" /><img class="k1" src="/icon/Kiwi Bird (1).svg" alt="" /><img class="k2" src="/icon/Kiwi-Bird (2).svg" alt="" /></span>
      <span class="bubble say" data-lines={JSON.stringify(kiwiLines)}>{kiwiLines[0]}</span>
    </div>
    <button class="ufo" id="ufo" style="left:85%;top:89%" aria-label="A UFO"><img src="/icon/UFO Flying.svg" alt="" /><i class="ufo-shadow"></i></button>

    <a class="book map-book" href={links.medium} target="_blank" rel="noopener" style="left:8%;top:68%" aria-label="Notes on Medium" title="Notes on Medium">
      <img class="b-closed" src="/icon/Notebook-closed.svg" alt="" /><img class="b-open" src="/icon/Notebook-open.svg" alt="" />
    </a>
    <div class="preview" id="preview"><img alt=""><div><b></b><span></span><em>Open →</em></div></div>
  </div>

  <div class="compass" id="compass" aria-hidden="true"><div class="needle"><i></i><span>N</span></div></div>
  <p class="map-foot">
    <span>© 2026 Yixi(Chris) Wu</span>
  </p>
</section>
