---
// Witness's adaptive capture, as a strip of time: one tick per frame the phone takes. At rest it waits maxInterval (20 s);
// a trigger (I stand up, someone speaks) drops it to minInterval (3 s), and it eases back by rampRatio (1.67).
// These are the capture app's defaults (PARAMETERS.md in the SpaceSelfLog repo). One unit is one second; the ticks draw in
// time order.
const X0 = 18, T = 300, W = 384, x = (t: number) => X0 + (t * W) / T;
const ramp = (from: number, until: number) => {
  const out: number[] = [];
  for (let t = from, gap = 3; t <= until; t += gap, gap = Math.min(20, gap * 1.67)) out.push(t);
  return out;
};
const triggers = [{ t: 92, label: 'I stand up' }, { t: 214, label: 'someone speaks' }];
const ticks = [0, 20, 40, 60, 80, ...ramp(92, 205), ...ramp(214, T)];
const y = 64, h = 34;
// Each tick draws at its moment along the strip, so the strip fills in time order.
const at = (t: number) => (0.5 + (t / T) * 2.4).toFixed(2);
---
<svg class="drawing capture r" viewBox="0 0 420 150" aria-hidden="true">
  <g class="obj">
    <path class="axis" pathLength="1" d={`M${X0 - 8} ${y + h} H${X0 + W + 8}`} />
    {ticks.map(t => (
      <path class="tick" pathLength="1" d={`M${x(t)} ${y + h} v${-h}`} style={`transition-delay:${at(t)}s`} />
    ))}
    <text class="gap" x={x(40)} y={y + h + 26}>quiet: every 20 s</text>
    <text class="gap" x={x(232)} y={y + h + 26}>then every 3 s</text>
  </g>
  {triggers.map(({ t, label }) => (
    <g class="obj trig" style={`--d:${at(t)}s`}>
      <path pathLength="1" d={`M${x(t)} ${y - 26} v14 m-4 -5 l4 5 l4 -5`} />
      <text x={x(t)} y={y - 34}>{label}</text>
    </g>
  ))}
</svg>

<style is:global>
  .drawing.capture { width: min(100%, 680px, calc(40svh * 420 / 150)) }
  /* Drawn larger than its own units on wide screens; see Sizes.astro. */
  .capture path { vector-effect: none; stroke-width: .9 }
  .capture .tick { stroke-opacity: .8 }
  .capture .axis { stroke-opacity: .3 }
  .capture text { font-size: 11px }
  @media (max-width: 600px) { .capture text { font-size: 14.5px } }
  .capture .trig text { fill: var(--fg) }
  .capture .trig path { stroke: var(--signal); stroke-opacity: 1 }
  /* Its own timing, over the shared .drawing .obj delays. */
  html.js .scene.on .drawing.capture .obj.trig path, html.js .scene.on .drawing.capture .obj.trig text { transition-delay: var(--d) }
  html.js .scene.on .drawing.capture .obj .gap { transition-delay: 3s }
  html.js .scene.on .drawing.capture .obj .axis { transition-delay: .3s }
  html.js .scene.on .drawing.capture .obj .tick { transition-duration: .35s }
</style>
