---
// Witness opens on one entry the agent wrote about me: the blurred frame it saw, the fields it filled in, and the
// sentence it drew from them. lead: the sentence above; stamp: when; fields: "key: value" as the log has them;
// quote: the last words of its observation. The frame is shown as the pipeline kept it, blurred.
interface Props { lead: string; stamp: string; fields: string[]; quote: string; frame: string }
const { lead, stamp, fields, quote, frame } = Astro.props;
const rows = fields.map(f => { const i = f.indexOf(':'); return { k: f.slice(0, i).trim(), v: f.slice(i + 1).trim() }; });
---
<div class="log-open">
  <p class="log-lead r">{lead}</p>
  <div class="log-entry">
    <img class="log-frame r" src={frame} alt="The camera's frame, blurred: a kitchen counter" decoding="async" />
    <div class="log-fields">
      <p class="log-stamp r">{stamp}</p>
      <dl>{rows.map(({ k, v }) => <div class="r"><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
    </div>
  </div>
  <p class="log-quote r">{quote}</p>
</div>

<style is:global>
  .log-open { display: flex; flex-direction: column; align-items: center; gap: clamp(20px, 3.6svh, 36px); width: min(100%, 760px) }
  .log-lead { margin: 0; font-size: clamp(30px, 4.6vw, 56px); font-weight: 300; line-height: 1.15; letter-spacing: -.01em; max-width: 22ch; text-wrap: balance }
  .log-entry { display: grid; grid-template-columns: minmax(0, 220px) minmax(0, 1fr); gap: 26px; align-items: center; width: 100%; text-align: left }
  .log-frame { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 6px; box-shadow: 0 18px 40px -22px rgba(0,0,0,.4) }
  .log-fields dl { margin: 0 }
  .log-fields { font-family: var(--font-mono); font-size: 12.5px; line-height: 1.5 }
  .log-fields dl > div { display: grid; grid-template-columns: 9ch minmax(0, 1fr); gap: 0 12px; padding: 3px 0 }
  .log-fields dt { color: var(--dim) }
  .log-fields dd { margin: 0; color: var(--fg) }
  .log-stamp { margin: 0 0 8px; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .04em; color: var(--dim) }
  .log-quote { margin: 0; max-width: 46ch; font-size: clamp(17px, 1.9vw, 22px); font-style: italic; font-weight: 300; line-height: 1.45; color: var(--dim); text-wrap: balance }
  @media (max-width: 600px) {
    .log-entry { grid-template-columns: 1fr; gap: 16px; justify-items: center }
    .log-frame { width: min(62%, 220px) }
    .log-fields { width: 100%; font-size: 11.5px }
    .log-fields dl > div { grid-template-columns: 8.5ch minmax(0, 1fr) }
  }
  /* The entry comes in the way the log writes it: the frame, then one field after another, then what it made of them. */
  html.js .gate:has(.log-open) .log-open .r { transition: opacity .7s ease }
  html.js .gate:has(.log-open) .log-open .r:not(.log-lead) { transform: none }
  html.js .gate:has(.log-open).on .log-frame { transition-delay: .7s }
  html.js .gate:has(.log-open).on .log-stamp { transition-delay: 1.1s }
  html.js .gate:has(.log-open).on .log-fields dl > div:nth-of-type(1) { transition-delay: 1.5s }
  html.js .gate:has(.log-open).on .log-fields dl > div:nth-of-type(2) { transition-delay: 1.8s }
  html.js .gate:has(.log-open).on .log-fields dl > div:nth-of-type(3) { transition-delay: 2.1s }
  html.js .gate:has(.log-open).on .log-fields dl > div:nth-of-type(4) { transition-delay: 2.4s }
  html.js .gate:has(.log-open).on .log-quote { transition-delay: 3.1s }
  html.js .gate:has(.log-open).on .stack > .lines .r { transition-delay: 4.1s }
  html.js .gate:has(.log-open).on .stack > .begin.r { transition-delay: 4.6s }
</style>
