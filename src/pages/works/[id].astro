---
import { getCollection, getEntry } from 'astro:content';
import '../../styles/detail.css';
import { glyph } from '../../lib/glyph';
import Desk from '../../components/Desk.astro';
import Balance from '../../components/Balance.astro';
import Reasons from '../../components/Reasons.astro';
import Bananas from '../../components/Bananas.astro';
import Decode from '../../components/Decode.astro';
import Sizes from '../../components/Sizes.astro';
import Diagram from '../../components/Diagram.astro';
import Poem from '../../components/Poem.astro';
import SelectOpener from '../../components/SelectOpener.astro';
import ContextOpener from '../../components/ContextOpener.astro';
import WheelOpener from '../../components/WheelOpener.astro';
import DockOpener from '../../components/DockOpener.astro';
import LogOpener from '../../components/LogOpener.astro';
import Capture from '../../components/Capture.astro';
import Tiers from '../../components/Tiers.astro';

// One page per work that has a narrative in src/content/details. Works without one keep their legacy page.
export async function getStaticPaths() {
  const details = await getCollection('details');
  return details.map(d => ({ params: { id: d.id } }));
}

const { id } = Astro.params;
const detail = (await getEntry('details', id))!;
const work = (await getEntry('works', id))!;
const { opener, openerStyle, openerNote, openerMedia, openerAlt, scenes, colophon, next } = detail.data;
// Drawings that take the place of media: the scene is not text-only, and it gets the wide stack.
const FIGURES = ['reasons', 'bananas', 'fit', 'sizes', 'capture', 'tiers'];
const isSign = (t: string) => t === '×' || t === '=';
// Openers drawn by their own component, with an italic note under them.
const OWN = ['selection', 'context', 'wheel', 'dock', 'log'];

const detailIds = new Set((await getCollection('details')).map(d => d.id));
const hrefOf = (wid: string, legacy?: string) => detailIds.has(wid) ? `/works/${wid}` : legacy;

// The Index overlay keeps the legacy sidebar's grouping: newest stage first.
const works = (await getCollection('works')).sort((a, b) =>
  b.data.stage.localeCompare(a.data.stage) || a.data.order - b.data.order || a.data.seq - b.data.seq);
const stages = [...new Set(works.map(w => w.data.stage))].map(s => ({ s, items: works.filter(w => w.data.stage === s) }));
const STAGE_NAME: Record<string, string> = { E: 'Lino', D: 'Graduate, year two', C: 'Graduate, year one', B: 'Gap year', A: 'Undergraduate' };

const nextWork = next ? await getEntry('works', next) : undefined;
// The work's code (stage letter + order), written inside its glyph as on the homepage badges.
const codeOf = (w: { data: { stage: string; order: number } }) => `${w.data.stage}${w.data.order}`;
const name = work.data.listTitle.replace(/\s*\(.*\)$/, '');
const isVideo = (src: string) => src.endsWith('.mp4');
const total = scenes.length + 1;
const pad = (n: number) => String(n).padStart(2, '0');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{name} · Yixi (Chris) Wu</title>
  <meta name="description" content={work.data.subtitle}>
  <link rel="icon" type="image/svg+xml" href="/icon/walking.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;1,6..72,300&family=JetBrains+Mono:wght@400;500&family=Poppins:wght@400;500&display=swap">
</head>
<body>
<header class="d-bar">
  <a class="home" href="/"><span aria-hidden="true">←</span> Yixi (Chris) Wu</a>
  <button class="index-btn" id="openIndex" type="button" aria-haspopup="dialog">Index</button>
</header>

<main class="story" id="story">
  <section class="scene gate" data-tone="paper">
    <div class="stack">
      <p class="kicker r"><span class="glyph badge" set:html={glyph(work.data.icon, codeOf(work))} />{name}</p>
      {openerMedia && openerStyle !== 'log' && (
        <figure class="r loose">
          {isVideo(openerMedia)
            ? <video src={openerMedia} poster={openerMedia.replace('.mp4', '-poster.jpg')} muted loop playsinline autoplay preload="auto" aria-label={openerAlt}></video>
            : <img src={openerMedia} alt={openerAlt ?? ''} decoding="async" />}
        </figure>
      )}
      {openerStyle === 'poem' && <div class="poem opener-poem">{opener.map(l => <p class="r">{l.split(/\*\*(.+?)\*\*/).map((t, j) => j % 2 ? <b>{t}</b> : t)}</p>)}</div>}
      {openerStyle === 'poem' && openerNote && <p class="note r">{openerNote}</p>}
      {openerStyle === 'selection' && <SelectOpener lead={opener[0]} word={opener[1]} actions={opener.slice(2)} />}
      {openerStyle === 'context' && <ContextOpener parts={opener} />}
      {openerStyle === 'wheel' && <WheelOpener lead={opener[0]} answer={opener[1]} rest={opener[2]} replies={opener.slice(3)} />}
      {openerStyle === 'dock' && <DockOpener lead={opener[0]} parts={opener.slice(1)} />}
      {openerStyle === 'log' && <LogOpener lead={opener[0]} stamp={opener[1]} fields={opener.slice(2, -1)} quote={opener[opener.length - 1]} frame={openerMedia!} />}
      {OWN.includes(openerStyle) && openerNote && <div class="lines"><p class="line r em">{openerNote}</p></div>}
      {openerStyle === 'poem' || OWN.includes(openerStyle) ? null : openerStyle === 'equation'
        ? <div class="equation">{opener.map(t => <p class:list={['r', isSign(t) ? 'sign' : 'term']}>{t}</p>)}</div>
        : <div class="lines">
            {opener.map((l, i) => <p class:list={['line', 'r', { em: i === opener.length - 1 }]}>{l}</p>)}
          </div>}
      <button class="begin r" id="begin" type="button">Begin</button>
    </div>
  </section>

  {scenes.map((sc, i) => {
    const list = sc.media ? [sc.media].flat() : [];
    return (
      <section class:list={['scene', { 'text-only': !list.length && !sc.card && !FIGURES.includes(sc.drawing ?? '') && sc.drawing !== 'decode' && !sc.poem && !sc.file && !sc.diagram, big: sc.big, wide: !!sc.facts || FIGURES.includes(sc.drawing ?? '') || !!sc.diagram }]} data-tone={sc.tone} data-year={sc.year ?? ''} data-n={pad(i + 1)}>
        {sc.backdrop === 'desk' && <Desk />}
        <div class:list={['stack', { wide: sc.wide }]}>
          {sc.drawing === 'balance' && <Balance />}
          {sc.drawing === 'reasons' && <Reasons />}
          {sc.drawing === 'bananas' && <Bananas />}
          {sc.drawing === 'fit' && <Bananas fit />}
          {sc.drawing === 'decode' && <Decode />}
          {sc.drawing === 'sizes' && <Sizes />}
          {sc.diagram && <Diagram {...sc.diagram} />}
          {sc.drawing === 'capture' && <Capture />}
          {sc.drawing === 'tiers' && <Tiers />}
          {sc.file && (
            <figure class="file r">
              <figcaption>{sc.file.name}</figcaption>
              <pre>{sc.file.lines.map(l => l.startsWith('! ') ? <mark>{l.slice(2)}</mark>
                : l.startsWith('#') ? <span class="h">{l}</span>
                : <span>{l.split(/(?=\s#\s)/)[0]}{l.includes(' # ') && <i>{l.slice(l.indexOf(' # '))}</i>}</span>)}</pre>
            </figure>
          )}
          {sc.poem && <Poem stanzas={sc.poem} />}
          {list.length > 0 && (
            <figure class:list={['r', { fade: list.length > 1 && !sc.gallery && !sc.pair, gallery: sc.gallery, pair: sc.pair, cutout: sc.cutout }]} style={sc.width ? `--w: ${sc.width}px` : undefined}>
              {list.map((src, j) => isVideo(src)
                ? <video data-round={sc.round} src={src} poster={src.replace('.mp4', '-poster.jpg')} muted loop playsinline preload="metadata" aria-label={sc.alt}></video>
                : <img class:list={[{ on: j === 0 }]} data-round={sc.round} src={src} alt={j === 0 || sc.gallery || sc.pair ? (sc.alt ?? '') : ''} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />)}
            </figure>
          )}
          {sc.card && (
            <figure class="site r">
              <a href={sc.card.href} target="_blank" rel="noopener">
                <img src={sc.card.image} alt={`The ${sc.card.title} homepage`} loading="lazy" decoding="async" />
                <span class="site-foot"><b>{sc.card.title}</b><span>{sc.card.label} ↗</span></span>
              </a>
            </figure>
          )}
          {sc.caption && <p class="caption r">{sc.caption}</p>}
          {sc.lead && <p class="lead r">{sc.lead}</p>}
          {sc.equation && <div class="equation">{sc.equation.map((t, k, all) => <p class:list={['r', isSign(t) ? 'sign' : 'term', { result: all[k - 1] === '=' }]}>{t}</p>)}</div>}
          {sc.facts && <div class="facts">{sc.facts.map(f => <div class="fact r"><h3>{f.t}</h3><p>{f.d}</p></div>)}</div>}
          {sc.line && <p class="line r">{sc.icon && sc.line.includes('[icon]')
            ? <Fragment>{sc.line.split('[icon]')[0]}<img class="app-icon" src={sc.icon} alt="" />{sc.line.split('[icon]')[1]}</Fragment>
            : sc.line}</p>}
          {sc.list && <ul class="inventory r">{sc.list.map(item => typeof item === 'string' ? <li>{item}</li> : <li>{item.t}<small>{item.d}</small></li>)}</ul>}
          {sc.note && <p class="note r">{sc.note}</p>}
          {sc.backdrop === 'desk' && <Desk inline />}
          {sc.link && <p class="r"><a class="go" href={sc.link.href} target={sc.link.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{sc.link.label} →</a></p>}
          {sc.footnote && <p class="footnote r">{sc.footnote}</p>}
        </div>
      </section>
    );
  })}

  <section class="scene colophon" data-tone="paper" data-n={pad(total)}>
    <div class="stack">
      <dl class="r">
        {colophon.map(c => <Fragment><dt>{c.k}</dt><dd>{c.href ? <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{c.v}</a> : c.v}</dd></Fragment>)}
      </dl>
      {nextWork && (
        <a class="next r" href={hrefOf(nextWork.id, nextWork.data.legacyUrl)}>
          <span class="glyph badge" set:html={glyph(nextWork.data.icon, codeOf(nextWork))} />
          <span><small>Next</small>{nextWork.data.listTitle}</span>
        </a>
      )}
    </div>
  </section>
</main>

<div class="year" id="year" aria-hidden="true"></div>
<div class="progress" id="progress" aria-hidden="true" data-total={pad(total)}></div>

<dialog class="index" id="index" aria-label="All works">
  <div class="index-inner">
    <button class="close" id="closeIndex" type="button">Close</button>
    {stages.map(({ s, items }) => (
      <section>
        <h2><b>{s}</b>{STAGE_NAME[s] ?? ''}</h2>
        <ul>
          {items.map(w => {
            const href = hrefOf(w.id, w.data.legacyUrl);
            return (
              <li class:list={[{ here: w.id === id }]}>
                {href
                  ? <a href={href}><span class="glyph" set:html={glyph(w.data.icon)} />{w.data.listTitle}<em>{w.data.date}</em></a>
                  : <span class="plain"><span class="glyph" set:html={glyph(w.data.icon)} />{w.data.listTitle}<em>{w.data.date}</em></span>}
              </li>
            );
          })}
        </ul>
      </section>
    ))}
    <p class="index-foot"><a href="/">Selected works</a> · <a href="/playground/">Playground</a> · <a href="/map.html">Original map</a></p>
  </div>
</dialog>

<script>
  import { initDetail } from '../../scripts/detail';
  initDetail();
</script>
</body>
</html>
