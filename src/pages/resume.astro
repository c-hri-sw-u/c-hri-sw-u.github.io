---
// The resume as a page: one US Letter sheet, the same on screen and on paper. Its words live in src/data/resume.ts.
// "Download PDF" is a real file, printed from this page by scripts/resume-pdf.mjs when the site deploys.
// Fonts are bundled (not Google Fonts) so the printed PDF is the same on any machine.
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import { person, work, research, projects, education, skills, honors, languages } from '../data/resume';
const PDF = '/Yixi-Chris-Wu-Resume.pdf';
// [words](url) → link, everything else escaped
const md = (s: string) => s.replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!).replace(/\[(.+?)\]\((.+?)\)/g, '<a href="$2">$1</a>');
const sections = [
  { label: 'Work', items: work },
  { label: 'Research', items: research },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Resume · Yixi (Chris) Wu</title>
  <meta name="description" content={`${person.name}, ${person.title}.`}>
  <link rel="icon" type="image/svg+xml" href="/icon/walking.svg">
</head>
<body>
<header class="rs-bar">
  <a class="home" href="/"><span aria-hidden="true">←</span> Yixi (Chris) Wu</a>
  <a class="dl" href={PDF} download="Yixi-Chris-Wu-Resume.pdf">Download PDF</a>
</header>

<main class="sheet">
  <header class="rs-head">
    <h1>{person.name}</h1>
    <p class="rs-title">{person.title}</p>
    <ul class="rs-contact">{person.contact.map(c => <li><a href={c.href}>{c.label}</a></li>)}</ul>
    <!-- The walking figure, the site's mark, large, walking along the line under the header -->
    <div class="rs-walker" aria-hidden="true"><img src="/icon/walking.svg" alt="" /></div>
  </header>

  <div class="rs-cols">
    <div class="rs-main">
      {sections.map(s => (
        <section>
          <h2>{s.label}</h2>
          {s.items.map(e => (
            <article class="rs-entry">
              <p class="rs-org"><span>{e.org}</span>{e.site && <> · <a href={e.href}>{e.site}</a></>} · {e.when}</p>
              <h3>{e.href && !e.site ? <a href={e.href}>{e.role}</a> : e.role}</h3>
              {e.lines.map(l => <p set:html={md(l)} />)}
            </article>
          ))}
        </section>
      ))}
      <section>
        <h2>Projects</h2>
        {projects.map(p => (
          <article class="rs-project">
            <h3>{p.href ? <a href={p.href}>{p.name}</a> : p.name}<span> · {p.meta}</span></h3>
            <p>{p.line}</p>
          </article>
        ))}
      </section>
    </div>

    <aside class="rs-side">
      <section>
        <h2>About</h2>
        <p>{person.about}</p>
      </section>
      <section>
        <h2>Education</h2>
        {education.map(e => (
          <article class="rs-edu">
            <p class="rs-row"><strong>{e.school}</strong><span>{e.when}</span></p>
            <p>{e.degree}</p>
            {e.note && <p class="rs-faint">{e.note}</p>}
          </article>
        ))}
      </section>
      <section>
        <h2>Skills</h2>
        <dl class="rs-skills">{skills.map(s => <div><dt>{s.t}</dt><dd>{s.d}</dd></div>)}</dl>
      </section>
      <section>
        <h2>Honors</h2>
        {honors.map(h => <p class="rs-row"><span>{h.t}</span><span>{h.when}</span></p>)}
      </section>
      <section>
        <h2>Languages</h2>
        <p>{languages}</p>
      </section>
    </aside>
  </div>

</main>

<style is:global>
  /* One Letter sheet (8.5 × 11 in). One typeface, three sizes, two greys: the hierarchy does the work.
     The work runs down the wide left column; reference facts sit in the narrow right one. */
  :root {
    --bg: #f4f3f0; --paper: #ffffff; --fg: #111111; --body: #3d3c39; --muted: #85837d; --line: rgba(17, 17, 17, .12);
    --font-body: "Poppins", "Helvetica Neue", Arial, sans-serif;
    color-scheme: light;
  }
  * { box-sizing: border-box }
  html, body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--font-body); -webkit-font-smoothing: antialiased }
  a { color: inherit; text-decoration: none }

  .rs-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; max-width: calc(8.5in + 32px); margin: 0 auto; padding: calc(18px + env(safe-area-inset-top, 0px)) 16px 16px }
  .home { font-weight: 500; font-size: 13.5px; color: var(--muted) }
  .home:hover { color: var(--fg) }
  .dl { font-size: 12.5px; font-weight: 500; color: var(--paper); background: var(--fg); border-radius: 999px; padding: 9px 16px }
  .dl:hover { opacity: .85 }
  .dl:focus-visible, .home:focus-visible { outline: 2px solid var(--fg); outline-offset: 3px }

  .sheet {
    position: relative; width: 8.5in; height: 11in; margin: 0 auto 48px; padding: .6in .65in .4in; background: var(--paper);
    box-shadow: 0 1px 0 rgba(0,0,0,.03), 0 24px 60px -28px rgba(0,0,0,.25); overflow: hidden;
    font-size: 8.6pt; line-height: 1.45; color: var(--body);
  }
  .sheet p, .sheet h1, .sheet h2, .sheet h3, .sheet ul, .sheet dl { margin: 0 }
  .sheet p, .sheet dd { text-wrap: pretty } /* no one-word last lines */
  .sheet a { text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 2px }
  .sheet a:hover { text-decoration-color: currentColor }
  .sheet strong { font-weight: 500; color: var(--fg) }

  .rs-head { position: relative; padding-bottom: 16pt; border-bottom: 1px solid var(--fg) }
  .rs-head h1 { font-size: 27pt; font-weight: 500; line-height: 1.05; letter-spacing: -.03em; color: var(--fg) }
  .rs-title { margin-top: 5pt !important; font-size: 11.5pt; color: var(--fg) }
  .rs-contact { list-style: none; padding: 0; margin-top: 9pt !important; display: flex; flex-wrap: wrap; gap: 4pt 16pt; font-size: 8.6pt }

  .rs-cols { display: grid; grid-template-columns: minmax(0, 1fr) 2.15in; gap: .4in; padding-top: 16pt }
  .sheet h2 { font-size: 9pt; font-weight: 500; color: var(--muted); margin-bottom: 8pt !important }
  .rs-main section + section { margin-top: 16pt }
  .rs-side section + section { margin-top: 13pt }

  .rs-entry + .rs-entry { margin-top: 12pt }
  .rs-org { font-size: 8.2pt; color: var(--muted) }
  .rs-org span { color: var(--fg); font-weight: 500 }
  .rs-entry h3 { margin: 1pt 0 3pt !important; font-size: 12pt; font-weight: 500; line-height: 1.3; letter-spacing: -.01em; color: var(--fg) }
  .rs-entry p + p { margin-top: 1.5pt }

  .rs-project + .rs-project { margin-top: 7pt }
  .rs-project h3 { font-size: 9.2pt; font-weight: 500; color: var(--fg) }
  .rs-project h3 span { font-weight: 400; color: var(--muted) }

  .rs-side { font-size: 8.2pt }
  .rs-row { display: flex; justify-content: space-between; gap: 8pt }
  .rs-row > span:last-child { color: var(--muted); white-space: nowrap }
  .rs-edu + .rs-edu { margin-top: 7pt }
  .rs-faint { color: var(--muted); margin-top: 1.5pt !important }
  .rs-skills > div + div { margin-top: 4pt }
  .rs-skills dt { font-weight: 500; color: var(--fg); display: inline; margin-right: .35em }
  .rs-skills dd { margin: 0; display: inline }
  .rs-side section > .rs-row + .rs-row { margin-top: 3pt }

  /* The figure's feet stand on the header's rule. In walking.svg the figure spans x 258–762 and y 206–1004 of 1024,
     so the box is 98% of the image tall (feet at its bottom) and the image overhangs on the right by the empty 26%. */
  .rs-walker { --h: 2.05in; position: absolute; right: calc(var(--h) * -.256); bottom: 0; width: var(--h); height: calc(var(--h) * .98); pointer-events: none }
  .rs-walker img { display: block; width: var(--h); height: var(--h) }

  /* Below a sheet's width the page reflows into one column at a readable size; the PDF keeps the Letter sheet. */
  @media screen and (max-width: 860px) {
    .sheet { width: auto; height: auto; overflow: visible; margin: 0 0 24px; padding: 28px 16px 0; box-shadow: none; font-size: 14px }
    .rs-head h1 { font-size: 32px }
    .rs-title { font-size: 16px }
    .rs-contact { font-size: 14px }
    .rs-cols { grid-template-columns: 1fr; gap: 28px; padding-top: 24px }
    .rs-main section + section, .rs-side section + section { margin-top: 24px }
    .sheet h2 { font-size: 14px }
    .rs-entry h3 { font-size: 18px }
    .rs-project h3 { font-size: 15px }
    .rs-side, .rs-org { font-size: 13.5px }
    .rs-head { padding-right: 84px }
    .rs-contact { flex-direction: column; gap: 4px }
    .rs-walker { --h: 112px }
  }

  @page { size: letter; margin: 0 }
  @media print {
    html, body { background: var(--paper) }
    .rs-bar { display: none }
    .sheet { margin: 0; box-shadow: none }
  }
</style>
</body>
</html>
