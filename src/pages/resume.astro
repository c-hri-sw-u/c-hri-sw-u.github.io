---
// The resume as a page: one US Letter sheet, the same on screen and on paper. Its words live in src/data/resume.ts.
// "Download PDF" is a real file, printed from this page by scripts/resume-pdf.mjs when the site deploys.
// Fonts are bundled (not Google Fonts) so the printed PDF is the same on any machine.
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/jetbrains-mono/400.css';
import { person, lino, research, experience, work, education, skills, honors } from '../data/resume';
const PDF = '/Yixi-Chris-Wu-Resume.pdf';
// **words** → bold, everything else escaped
const md = (s: string) => s.replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
const entries = [
  { label: 'Research', items: research },
  { label: 'Industry', items: experience },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Resume · Yixi (Chris) Wu</title>
  <meta name="description" content={`${person.name}, ${person.title}. ${person.line}`}>
  <link rel="icon" type="image/svg+xml" href="/icon/walking.svg">
</head>
<body>
<header class="rs-bar">
  <a class="home" href="/"><span aria-hidden="true">←</span> Yixi (Chris) Wu</a>
  <a class="dl" href={PDF} download="Yixi-Chris-Wu-Resume.pdf">Download PDF</a>
</header>

<main class="sheet">
  <header class="rs-head">
    <div class="rs-id">
      <h1><img class="rs-walker" src="/icon/walking.svg" alt="" />{person.name}</h1>
      <p class="rs-title">{person.title}</p>
      <p class="rs-line">{person.line}</p>
    </div>
    <ul class="rs-contact">
      {person.contact.map(c => <li><a href={c.href}>{c.label}</a></li>)}
    </ul>
  </header>

  <section class="rs-row rs-lino">
    <div class="rs-rail">
      <h2>Now</h2>
      <p class="rs-when">{lino.when}</p>
    </div>
    <div class="rs-feature">
      <h3><img class="rs-icon" src="/media/works/lino-app/app-icon.webp" alt="" /><a href={lino.href}>{lino.name}</a><span class="rs-role"> · {lino.role}</span><a class="rs-url" href={lino.href}>lino.one</a></h3>
      <p class="rs-lede">{lino.lede}</p>
      <ul class="rs-points">{lino.lines.map(l => <li set:html={md(l)} />)}</ul>
    </div>
  </section>

  {entries.map(s => (
    <section class="rs-row">
      <div class="rs-rail"><h2>{s.label}</h2></div>
      <div class="rs-list">
        {s.items.map(e => (
          <article class="rs-entry">
            <p class="rs-when">{e.when}</p>
            <div>
              <h3>{e.href ? <a href={e.href}>{e.what}</a> : e.what}{e.role && <span class="rs-role"> · {e.role}</span>}</h3>
              {e.lines.map(l => <p set:html={md(l)} />)}
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="rs-row">
    <div class="rs-rail"><h2>Selected work</h2></div>
    <div class="rs-works">
      {work.map(w => (
        <article>
          <h3>{w.href ? <a href={w.href}>{w.name}</a> : w.name}<span class="rs-tag"> {w.tag}, {w.when}</span></h3>
          <p>{w.line}</p>
        </article>
      ))}
    </div>
  </section>

  <footer class="rs-foot">
    <section>
      <h2>Education</h2>
      {education.map(e => (
        <article class="rs-edu">
          <h3>{e.what}<span class="rs-when"> {e.when}</span></h3>
          <p>{e.role}</p>
          {e.lines.map(l => <p class="rs-muted">{l}</p>)}
        </article>
      ))}
    </section>
    <section>
      <h2>Skills</h2>
      <dl class="rs-skills">{skills.map(s => <div><dt>{s.t}</dt><dd>{s.d}</dd></div>)}</dl>
    </section>
    <section>
      <h2>Honors</h2>
      <ul class="rs-plain">{honors.map(h => <li>{h}</li>)}</ul>
      <h2 class="rs-h2-gap">Languages</h2>
      <p>English, Mandarin (native)</p>
    </section>
  </footer>
</main>

<style is:global>
  /* One Letter sheet (8.5 × 11 in), in the homepage's type: Poppins for words, JetBrains Mono for labels and dates.
     A left rail carries section names and dates; Lino, the one thing told in full, sits on a tinted panel. */
  :root {
    --bg: #f4f3f0; --paper: #ffffff; --panel: #f5f4f1; --fg: #111111; --muted: #6d6b66; --line: rgba(17, 17, 17, .12);
    --font-body: "Poppins", "Helvetica Neue", Arial, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, Menlo, monospace;
    --rail: 1.02in;
    color-scheme: light;
  }
  * { box-sizing: border-box }
  html, body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--font-body); -webkit-font-smoothing: antialiased }
  a { color: inherit; text-decoration: none }

  .rs-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; max-width: calc(8.5in + 32px); margin: 0 auto; padding: calc(18px + env(safe-area-inset-top, 0px)) 16px 16px }
  .home { font-weight: 500; font-size: 13.5px; color: var(--muted) }
  .home:hover { color: var(--fg) }
  .dl { font-family: var(--font-mono); font-size: 12px; letter-spacing: .02em; color: var(--paper); background: var(--fg); border-radius: 999px; padding: 9px 16px }
  .dl:hover { opacity: .85 }
  .dl:focus-visible, .home:focus-visible { outline: 2px solid var(--fg); outline-offset: 3px }

  .sheet {
    width: 8.5in; height: 11in; margin: 0 auto 48px; padding: .52in .6in .45in; background: var(--paper);
    box-shadow: 0 1px 0 rgba(0,0,0,.03), 0 24px 60px -28px rgba(0,0,0,.25); overflow: hidden;
    font-size: 8pt; line-height: 1.38;
  }
  .sheet p, .sheet h1, .sheet h2, .sheet h3, .sheet ul, .sheet dl { margin: 0 }
  .sheet strong { font-weight: 600 }
  .sheet a:hover { text-decoration: underline }

  /* Header: the name and the walking figure, contacts set right in mono, then one sentence of what I do */
  .rs-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; padding-bottom: 12pt; border-bottom: 1px solid var(--fg) }
  .rs-head h1 { display: flex; align-items: center; gap: .16em; font-size: 26pt; font-weight: 500; line-height: 1; letter-spacing: -.03em }
  .rs-walker { width: 1.4em; height: 1.4em; flex: none; margin: -.2em -.06em -.2em -.26em; position: relative; top: -.08em } /* the figure sits small and low in its frame */
  .rs-title { margin-top: 8pt !important; font-size: 11pt; font-weight: 500; letter-spacing: -.01em }
  .rs-contact { list-style: none; padding: 0; white-space: nowrap; text-align: right; font-family: var(--font-mono); font-size: 7.2pt; line-height: 1.7; color: var(--muted) }
  .rs-contact a:hover { color: var(--fg) }
  .rs-line { margin-top: 2pt !important; font-size: 11pt; line-height: 1.3; letter-spacing: -.01em; color: var(--muted) }

  /* Rows: a rail on the left (section name, dates), the content on the right */
  .rs-row { display: grid; grid-template-columns: var(--rail) minmax(0, 1fr); padding: 9pt 0; border-bottom: 1px solid var(--line) }
  .sheet h2 { font-family: var(--font-mono); font-size: 7.4pt; font-weight: 400; letter-spacing: .01em; color: var(--muted) }
  .rs-when { font-family: var(--font-mono); font-size: 7pt; color: var(--muted); letter-spacing: .01em; white-space: nowrap }
  .rs-rail .rs-when { margin-top: 3pt; white-space: normal; padding-right: 8pt }
  .sheet h3 { font-size: 9.2pt; font-weight: 600; line-height: 1.3; letter-spacing: -.005em }
  .rs-role { font-weight: 400 }

  .rs-lino { padding-top: 11pt }
  .rs-feature { background: var(--panel); border-radius: 7px; padding: 10pt 12pt 11pt; margin: -2pt 0 }
  .rs-feature h3 { display: flex; align-items: center; font-size: 12pt; letter-spacing: -.015em }
  .rs-feature .rs-role { margin-left: .25em }
  .rs-icon { width: 16pt; height: 16pt; border-radius: 4pt; margin-right: 6pt }
  .rs-url { margin-left: auto; font-family: var(--font-mono); font-size: 7pt; font-weight: 400; color: var(--muted); letter-spacing: 0 }
  .rs-lede { margin-top: 5pt !important; font-size: 9.2pt; line-height: 1.4 }
  .rs-points { list-style: none; padding: 0; margin-top: 8pt !important; display: grid; grid-template-columns: 1fr 1fr; gap: 7pt 16pt }
  .rs-points li { padding-top: 6pt; border-top: 1px solid var(--line) }

  .rs-list { display: grid; gap: 5pt }
  .rs-entry { display: grid; grid-template-columns: .74in minmax(0, 1fr); gap: 0 }
  .rs-entry .rs-when { padding-top: 1.6pt }
  .rs-entry p { margin-top: 1.5pt !important }

  .rs-works { display: grid; grid-template-columns: 1fr 1fr; gap: 6pt 16pt }
  .rs-tag { font-family: var(--font-mono); font-size: 7pt; font-weight: 400; color: var(--muted); margin-left: 3pt; white-space: nowrap }
  .rs-works p:not(.rs-tag) { margin-top: 2pt !important }

  .rs-foot { display: grid; grid-template-columns: 1.2fr 1.3fr .75fr; gap: 0 16pt; padding-top: 9pt }
  .rs-foot h2 { margin-bottom: 5pt !important }
  .rs-foot .rs-h2-gap { margin-top: 9pt !important }
  .rs-edu + .rs-edu { margin-top: 6pt }
  .rs-edu h3 { font-size: 8.6pt }
  .rs-edu .rs-when { margin-left: 4pt; font-weight: 400 }
  .rs-muted { color: var(--muted); margin-top: 1.5pt !important }
  .rs-skills > div + div { margin-top: 3.5pt }
  .rs-skills dt { font-weight: 600; display: inline }
  .rs-skills dt::after { content: "  " }
  .rs-skills dd { margin: 0; display: inline }
  .rs-plain { list-style: none; padding: 0 }
  .rs-plain li + li { margin-top: 2.5pt }

  /* Below a sheet's width the page reflows into one column at a readable size; the PDF keeps the Letter sheet. */
  @media screen and (max-width: 860px) {
    .sheet { width: auto; height: auto; overflow: visible; margin: 0 0 24px; padding: 28px 16px 36px; box-shadow: none; font-size: 14px; line-height: 1.5 }
    .rs-head { flex-direction: column; gap: 12px }
    .rs-head h1 { font-size: 30px }
    .rs-title { font-size: 16px }
    .rs-contact { text-align: left; font-size: 12px }
    .rs-line { font-size: 19px }
    .rs-row { grid-template-columns: 1fr; gap: 8px; padding: 18px 0 }
    .rs-feature { margin: 0; padding: 16px }
    .rs-feature h3 { font-size: 18px; flex-wrap: wrap }
    .rs-icon { width: 24px; height: 24px; border-radius: 6px }
    .rs-lede { font-size: 15px }
    .rs-points, .rs-works, .rs-foot { grid-template-columns: 1fr; gap: 12px }
    .rs-entry { grid-template-columns: 1fr }
    .sheet h2 { font-size: 12px }
    .sheet h3 { font-size: 15px }
    .rs-when, .rs-tag, .rs-url { font-size: 11.5px }
    .rs-foot { padding-top: 18px; gap: 20px }
  }

  @page { size: letter; margin: 0 }
  @media print {
    html, body { background: var(--paper) }
    .rs-bar { display: none }
    .sheet { margin: 0; box-shadow: none }
    a { text-decoration: none !important }
  }
</style>
</body>
</html>
