---
import { getCollection } from 'astro:content';
import '../styles/home.css';
import { glyph, glyphPath, describe, SHAPE_TEXT, type Icon } from '../lib/glyph';
import { selected, concepts, links, type Cell } from '../data/home';

// Chronological path through every work, the same order the legacy map draws its lines in.
const works = (await getCollection('works')).sort((a, b) =>
  a.data.stage.localeCompare(b.data.stage) || a.data.order - b.data.order || a.data.seq - b.data.seq);
const byId = Object.fromEntries(works.map(w => [w.id, w]));
const onHome = new Set([...selected, ...concepts].map(c => c.id));
const latestId = works[works.length - 1].id;

let linePaths = '';
for (let i = 0; i < works.length - 1; i++) {
  const a = works[i].data, b = works[i + 1].data;
  const dash = a.stage !== b.stage ? ' class="dash"' : '';
  linePaths += `<path${dash} d="M${a.icon.position[0]} ${a.icon.position[1]}L${b.icon.position[0]} ${b.icon.position[1]}"/>`;
}
// The 2024 Lino prototype and the 2026 product are one story: a faint thick line ties them.
if (byId['lino'] && byId['lino-app']) {
  const a = byId['lino'].data.icon.position, b = byId['lino-app'].data.icon.position;
  linePaths += `<path d="M${a[0]} ${a[1]}L${b[0]} ${b[1]}" style="stroke-width:3;opacity:.12"/>`;
}
const miniLines = linePaths.replace(/class="dash"/g, 'class="l d"').replace(/<path d=/g, '<path class="l" d=').replace(/ style="[^"]*"/g, '');
const miniIcons = works.map(w => `<g transform="translate(${w.data.icon.position[0]} ${w.data.icon.position[1]}) scale(.13)">${glyphPath(w.data.icon)}</g>`).join('');

const iconOf = (c: Cell) => byId[c.id].data.icon as Icon;
const legendShapes = ['circle', 'square', 'star4rounded', 'star6', 'star6rounded', 'star8rounded'] as const;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Yixi (Chris) Wu · Design engineer</title>
  <meta name="description" content="Yixi (Chris) Wu, design engineer and founder of Lino. Work across software, hardware and space.">
  <link rel="icon" type="image/svg+xml" href="/icon/walking.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&family=JetBrains+Mono:wght@400;500&display=swap">
</head>
<body>
<header class="bar">
  <a class="wordmark" href="/">Yixi (Chris) Wu</a>
  <div class="switch" role="group" aria-label="View">
    <button id="toList" aria-pressed="true">Selected</button>
    <button id="toMap" aria-pressed="false"><span class="mini-glyph" set:html={glyph({ shape: 'star8rounded', fill: 'black', dashed: false, skewed: false })} />Map</button>
  </div>
  <nav class="links-top">
    <a href={links.resume} target="_blank" rel="noopener">Resume</a>
    <a href={links.playground}>Playground</a>
    <a href={`mailto:${links.email}`}>Email</a>
  </nav>
</header>

<main id="top">
  <section class="intro">
    <h1>Hi, I'm Chris. Founder of <em>Lino</em>.</h1>
    <p>Design engineer working across software, hardware and space.</p>
  </section>

  {[{ cells: selected, cls: 'grid', label: 'Selected works' }, { cells: concepts, cls: 'shelf', label: 'Concepts' }].map(({ cells, cls, label }, gi) => (
    <Fragment>
      {gi === 1 && <div class="concepts-head sec-head"><h2>Concepts</h2><p>Designed, not built</p></div>}
      <section class={cls} aria-label={label}>
        {cells.map(c => (
          <article class:list={['card', { lead: c.lead }]} data-id={c.id}>
            <a class="cover" href={byId[c.id].data.legacyUrl} aria-label={`${c.name}: ${c.what}`}></a>
            <button class="glyph-btn" data-id={c.id} aria-label={`Show ${c.name} on the map`}>
              <Fragment set:html={glyph(iconOf(c))} />
              <span class="tip">{describe(iconOf(c))}<small>Click to see where it sits on the map</small></span>
            </button>
            <div class="media">
              {c.moments.map((m, i) => m.kind === 'video'
                ? <video class:list={[{ on: i === 0, flat: m.flat }]} src={m.src} poster={m.src.replace('.mp4', '-poster.jpg')} muted loop playsinline preload={i === 0 ? 'auto' : 'none'} autoplay={i === 0} aria-hidden="true"></video>
                : <img class:list={[{ on: i === 0, flat: m.flat }]} src={m.src} alt="" loading={c.lead ? 'eager' : 'lazy'} decoding="async" />)}
            </div>
            <div class="cap">
              <div class="what">{c.name} <span>/ {c.what}</span>{c.moments.length > 1 && <span class="dots">{c.moments.map((_, i) => <i class:list={[{ on: i === 0 }]}></i>)}</span>}</div>
              <div class="how">{c.how}</div>
            </div>
          </article>
        ))}
        {gi === 0 && (
          <article class="card maptile" id="mapTile">
            <button class="cover" aria-label={`Open the map of all ${works.length} works`}></button>
            <div class="media"><svg class="mini" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" aria-hidden="true" set:html={miniLines + miniIcons}></svg></div>
            <div class="cap"><div class="what">All {works.length} works <span>/ the map</span></div><div class="how">Enter →</div></div>
          </article>
        )}
      </section>
    </Fragment>
  ))}

  <footer class="foot">
    <span>© Yixi (Chris) Wu</span>
    <a class="full-map" href={links.fullMap}>Open the original full map →</a>
  </footer>
</main>

<section id="map" aria-label={`Map of all ${works.length} works`}>
  <div class="plane" id="plane">
    <span class="axis ax-top">Digital</span><span class="axis ax-bot">Physical</span>
    <span class="axis ax-l">Reality</span><span class="axis ax-r">Vision</span>
    <svg class="links" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" set:html={linePaths}></svg>
    {works.map(w => (
      <button class:list={['mapicon', { feat: onHome.has(w.id) }]} data-id={w.id} data-title={w.data.listTitle}
        data-date={w.data.date} data-preview={w.data.preview} data-url={w.data.legacyUrl}
        style={`left:${w.data.icon.position[0]}%;top:${w.data.icon.position[1]}%`} aria-label={w.data.listTitle}>
        <Fragment set:html={glyph(w.data.icon)} />
        <span class="lbl">{w.data.listTitle}</span>
        {w.id === latestId && <span class="now">I’m into this now</span>}
      </button>
    ))}
    <div class="preview" id="preview"><img alt=""><div><b></b><span></span></div></div>
  </div>
  <a class="map-full" href={links.fullMap}>Original map, with filters →</a>
</section>
<details class="legend" id="legend">
  <summary>How to read the icons</summary>
  <div class="rows">
    {legendShapes.map(s => <Fragment><Fragment set:html={glyph({ shape: s, fill: 'white', dashed: false, skewed: false })} /><span>{SHAPE_TEXT[s]}</span></Fragment>)}
    <Fragment set:html={glyph({ shape: 'circle', fill: 'black', dashed: false, skewed: false })} /><span>Solid fill: finished project</span>
    <Fragment set:html={glyph({ shape: 'circle', fill: 'white', dashed: true, skewed: false })} /><span>Dashed: unfinished</span>
    <Fragment set:html={glyph({ shape: 'square', fill: 'black', dashed: false, skewed: true })} /><span>Skewed: less serious, weirder</span>
    <span></span><span class="dim">Up = digital, down = physical. Left = reality, right = vision.</span>
  </div>
</details>

<script>
  import { initHome } from '../scripts/home';
  initHome();
</script>
</body>
</html>
